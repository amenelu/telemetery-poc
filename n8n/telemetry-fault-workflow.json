{
  "name": "Telemetry Fault Alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "diagnostic-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "0473200d-239a-4ef3-8ee0-d15ff616d0a0",
      "name": "Telemetry Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "b508d6bd-bfa2-4b34-ad87-c2d00e85f559"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ba6f0bee-f615-45df-8c80-c62dad261f54",
              "name": "severity",
              "value": "={{ $json.body.coolant_temp_c > 110 || $json.body.battery_voltage < 11.5 ? 'CRITICAL' : 'HIGH' }}",
              "type": "string"
            },
            {
              "id": "496a4e74-1f5d-499e-a874-19cc5b29328d",
              "name": "alert_message",
              "value": "=🚨 VEHICLE FAULT DETECTED\n\nDevice: {{ $json.body.device_id }}\nDTC Code: {{ $json.body.dtc_code || 'None' }}\nEngine RPM: {{ $json.body.engine_rpm }}\nCoolant: {{ $json.body.coolant_temp_c }}°C\nBattery: {{ $json.body.battery_voltage }}V\nRecorded: {{ $json.body.recorded_at }}",
              "type": "string"
            },
            {
              "id": "dce5d63d-5fb2-4578-ae91-2ee5b4ca02db",
              "name": "telemetry_record",
              "value": "={{ $json.body }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "de887719-6524-4737-a266-e50032fe43fa",
      "name": "Format Incident Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Telemetry Webhook": {
      "main": [
        [
          {
            "node": "Format Incident Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
